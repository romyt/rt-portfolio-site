---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout currentPath="/skills" title="Skills · Romain-Rolland F Tohouri">
  <section class="section">
    <div class="section-header">
      <h1 class="section-title">Skills</h1>
      <p class="section-subtitle">
        A condensed view of the capabilities highlighted in the resume.
      </p>
    </div>
    <div class="card-grid">
      <article class="card">
        <h2 class="card-title">Digital health & leadership</h2>
        <p class="card-meta">
          Program design, governance, and multi-stakeholder coordination for national HIS and One Health
          initiatives.
        </p>
        <div class="card-tags">
          <span class="tag">Program leadership</span>
          <span class="tag">Stakeholder engagement</span>
          <span class="tag">Capacity building</span>
        </div>
      </article>
      <article class="card">
        <h2 class="card-title">DevOps & cloud infrastructure</h2>
        <p class="card-meta">
          High-availability clusters, CI/CD, observability, and secure cloud operations for health data
          platforms.
        </p>
        <div class="card-tags">
          <span class="tag">Kubernetes</span>
          <span class="tag">Talos Linux</span>
          <span class="tag">GitOps / CI/CD</span>
        </div>
      </article>
      <article class="card">
        <h2 class="card-title">Health information systems</h2>
        <p class="card-meta">
          DHIS2 configuration, deployment, optimization, and integration with other systems.
        </p>
        <div class="card-tags">
          <span class="tag">DHIS2</span>
          <span class="tag">Interoperability</span>
          <span class="tag">Enterprise architecture</span>
        </div>
      </article>
      <article class="card">
        <h2 class="card-title">AI & advanced analytics</h2>
        <p class="card-meta">
          Local LLM integration, automated bulletins, and data visualization for decision support.
        </p>
        <div class="card-tags">
          <span class="tag">LLMs</span>
          <span class="tag">Data visualization</span>
          <span class="tag">Automation</span>
        </div>
      </article>
    </div>
  </section>
</MainLayout>
