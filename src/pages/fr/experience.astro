---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout currentPath="/fr/experience">
  <section class="section">
    <div class="section-header">
      <h1 class="section-title">Expérience</h1>
      <p class="section-subtitle">
        Rôles de leadership, d'architecture et technique dans des programmes internationaux de santé numérique.
      </p>
    </div>
    <div class="card-grid">
      <article class="card">
        <h2 class="card-title">Manager & Ingénieur DevOps Principal · YaLIM LLC</h2>
        <p class="card-meta">Fairfax, Virginia · 2022 — Présent</p>
        <p class="card-meta">
          Direction de la conception et de l'exploitation de clusters Kubernetes basés sur Talos et de pipelines CI/CD pour YaLIM
          Cloud, hébergeant plusieurs systèmes d'information de santé nationaux basés sur DHIS2 et plateformes de surveillance des maladies.
        </p>
      </article>
      <article class="card">
        <h2 class="card-title">Directeur du Conseil · HISP Côte d'Ivoire</h2>
        <p class="card-meta">Abidjan, Côte d'Ivoire · 2015 — Présent</p>
        <p class="card-meta">
          Fournir un leadership stratégique pour le renforcement du système national de santé et la
          gouvernance de la santé numérique en étroite collaboration avec le Ministère de la Santé.
        </p>
      </article>
      <article class="card">
        <h2 class="card-title">Architecte Principal · MOMENTUM Knowledge Accelerator</h2>
        <p class="card-meta">Arlington, VA · 2022 — 2025</p>
        <p class="card-meta">
          Conception d'une architecture intégrée pour la surveillance des données de programme dans le cadre d'un accord de
          coopération USAID de 30M$, incluant l'intégration de données provenant de plusieurs systèmes externes.
        </p>
      </article>
      <article class="card">
        <h2 class="card-title">Conseiller SIS Senior · JSI</h2>
        <p class="card-meta">Arlington, VA · 2019 — 2025</p>
        <p class="card-meta">
          Direction des équipes DHIS2 et de développeurs pour les projets JSI, guidant les implémentations SIS nationales, les
          évaluations de sécurité et les initiatives d'utilisation des données dans plusieurs pays.
        </p>
      </article>
    </div>
  </section>
</MainLayout>
