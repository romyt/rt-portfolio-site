---
import MainLayout from "../layouts/MainLayout.astro";
import Resume from "../content/resume/romain-rolland-resume.md";
---

<MainLayout currentPath="/">
  <section class="hero">
    <div>
      <div class="hero-eyebrow">Digital health · DevOps · AI</div>
      <h1 class="hero-title">
        I build resilient
        <span class="hero-highlight">digital health platforms</span>
        at national scale.
      </h1>
      <p class="hero-subtitle">
        Digital health leader and DevOps engineer with 15+ years of experience designing and operating
        health information systems across Africa, the Caribbean, and the United States. I specialize in
        Health Information Systems, Kubernetes, and secure, cloud-native architectures.
      </p>
      <div class="hero-actions">
        <a href="#resume" class="button-primary">View full resume</a>
        <a href="/projects" class="button-secondary">Explore projects</a>
      </div>
      <div class="hero-meta">
        <span><strong>15+ years</strong> in digital health</span>
        <span><strong>8+ countries</strong> supported</span>
        <span><strong>National</strong> HIS & surveillance systems</span>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Profile summary">
      <div class="hero-card">
        <div class="hero-card-header">
          <div>
            <div class="hero-card-title">Currently</div>
            <div class="hero-card-name">Romain-Rolland F Tohouri</div>
            <div class="hero-card-role">Digital Health Leader · DevOps Engineer</div>
          </div>
          <div class="hero-card-country">Based in Fairfax, VA</div>
        </div>
        <div class="hero-card-tags">
          <span class="tag">Kubernetes & Talos</span>
          <span class="tag">DHIS2</span>
          <span class="tag">CI/CD</span>
          <span class="tag">Interoperability</span>
          <span class="tag">AI & LLMs</span>
        </div>
        <div class="hero-card-footer">
          <strong>Impact:</strong> leading design and deployment of high-availability HIS platforms, national
          disease surveillance, and secure health data infrastructure.
        </div>
      </div>
    </aside>
  </section>

  <section class="section" aria-labelledby="section-expertise">
    <div class="section-header">
      <h2 id="section-expertise" class="section-title">Core areas of expertise</h2>
      <p class="section-subtitle">From strategy and architecture to DevOps implementation and mentoring.</p>
    </div>
    <div class="card-grid">
      <article class="card">
        <h3 class="card-title">Digital health leadership</h3>
        <p class="card-meta">
          Steering national digital health strategies, governance structures, and multi-stakeholder
          coordination.
        </p>
        <div class="card-tags">
          <span class="tag">National strategies</span>
          <span class="tag">Governance</span>
          <span class="tag">Capacity building</span>
        </div>
      </article>
      <article class="card">
        <h3 class="card-title">DevOps & cloud infrastructure</h3>
        <p class="card-meta">
          Designing and operating Kubernetes clusters, CI/CD pipelines, and observability for mission-critical
          systems.
        </p>
        <div class="card-tags">
          <span class="tag">Kubernetes</span>
          <span class="tag">Talos Linux</span>
          <span class="tag">GitOps / CI/CD</span>
        </div>
      </article>
      <article class="card">
        <h3 class="card-title">Health information systems</h3>
        <p class="card-meta">
          Implementing and optimizing DHIS2-based platforms, interoperability layers, and data warehouse
          architectures.
        </p>
        <div class="card-tags">
          <span class="tag">DHIS2</span>
          <span class="tag">Interoperability</span>
          <span class="tag">Enterprise architecture</span>
        </div>
      </article>
      <article class="card">
        <h3 class="card-title">AI for health information</h3>
        <p class="card-meta">
          Applying AI and local LLMs for automated bulletins, decision support, and data storytelling.
        </p>
        <div class="card-tags">
          <span class="tag">LLMs</span>
          <span class="tag">Automation</span>
          <span class="tag">Decision support</span>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="section-highlight-roles">
    <div class="section-header">
      <h2 id="section-highlight-roles" class="section-title">Selected leadership roles</h2>
      <p class="section-subtitle">A snapshot of recent positions and impact.</p>
    </div>
    <div class="card-grid">
      <article class="card">
        <h3 class="card-title">Manager & Lead DevOps Engineer</h3>
        <p class="card-meta">YaLIM LLC · 2022 — Present</p>
        <p class="card-meta">
          Designed and operated Talos-based Kubernetes clusters powering YaLIM Cloud (yalim.cloud / dhis2.cloud)
          with multiple national HIS deployments.
        </p>
      </article>
      <article class="card">
        <h3 class="card-title">Board Director</h3>
        <p class="card-meta">HISP Côte d'Ivoire · 2015 — Present</p>
        <p class="card-meta">
          Leading national health information system strengthening and digital health strategy in partnership
          with the Ministry of Health.
        </p>
      </article>
      <article class="card">
        <h3 class="card-title">Lead Architect</h3>
        <p class="card-meta">MOMENTUM Knowledge Accelerator · 2022 — 2025</p>
        <p class="card-meta">
          Architected integrated systems for managing program data across multiple awards under a $30M
          cooperative agreement.
        </p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="section-key-skills">
    <div class="section-header">
      <h2 id="section-key-skills" class="section-title">Key skills at a glance</h2>
      <p class="section-subtitle">Representative capabilities based on your current resume.</p>
    </div>
    <div class="section-inline-list">
      <span>Digital health strategy</span>
      <span>DHIS2 deployment & optimization</span>
      <span>Kubernetes & Talos Linux</span>
      <span>DevOps & CI/CD</span>
      <span>Systems interoperability</span>
      <span>AI & local LLM integration</span>
      <span>Capacity building & mentoring</span>
      <span>Advanced data analysis & visualization</span>
    </div>
  </section>

  <section id="resume" class="section" aria-labelledby="section-resume">
    <div class="section-header">
      <h2 id="section-resume" class="section-title">Full resume</h2>
      <p class="section-subtitle">
        Rendered directly from a Markdown file so you can keep your portfolio up to date with simple edits.
      </p>
    </div>
    <div class="resume-section">
      <Resume />
    </div>
  </section>
</MainLayout>
