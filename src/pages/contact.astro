---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout currentPath="/contact" title="Contact · Romain-Rolland F Tohouri">
  <section class="section">
    <div class="section-header">
      <h1 class="section-title">Get in touch</h1>
      <p class="section-subtitle">
        The fastest way to reach me is by email. I am open to collaborations, consulting, and technical
        leadership opportunities.
      </p>
    </div>
    <div class="card">
      <h2 class="card-title">Contact details</h2>
      <p class="card-meta">Fairfax, VA · Eastern Time (US)</p>
      <ul>
        <li>Email: <a href="mailto:romain(at)tohouri.com">romain@tohouri.com</a></li>
      </ul>
    </div>
    <div class="card" style="margin-top: 1.2rem;">
      <h2 class="card-title">Profiles</h2>
      <ul>
        <li>
          LinkedIn:
          <a href="https://www.linkedin.com/in/tohouri/" target="_blank" rel="noreferrer">View LinkedIn profile</a>
        </li>
        <li>
          GitHub:
          <a href="https://github.com/romyt" target="_blank" rel="noreferrer">View GitHub profile</a>
        </li>
      </ul>
    </div>
  </section>
</MainLayout>
