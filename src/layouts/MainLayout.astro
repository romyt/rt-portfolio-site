---
import "../styles/global.css";

const {
  title = "Romain-Rolland F Tohouri",
  description = "Portfolio of Romain-Rolland F Tohouri – digital health leader and DevOps engineer.",
  currentPath = "/",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="app-shell">
      <header class="app-header">
        <div class="app-container app-header-inner">
          <a href="/" class="brand" aria-label="Go to home">
            <div class="brand-avatar">RT</div>
            <div class="brand-meta">
              <span class="brand-name">Romain-Rolland F Tohouri</span>
              <span class="brand-tagline">Digital Health & DevOps</span>
            </div>
          </a>
          <nav class="nav-links" aria-label="Main navigation">
            <a href="/" class={`nav-link ${currentPath === "/" ? "nav-link-active" : ""}`}>
              Overview
            </a>
            <a href="/experience" class={`nav-link ${currentPath === "/experience" ? "nav-link-active" : ""}`}>
              Experience
            </a>
            <a href="/projects" class={`nav-link ${currentPath === "/projects" ? "nav-link-active" : ""}`}>
              Projects
            </a>
            <a href="/skills" class={`nav-link ${currentPath === "/skills" ? "nav-link-active" : ""}`}>
              Skills
            </a>
            <a href="/contact" class={`nav-link nav-link-pill ${currentPath === "/contact" ? "nav-link-active" : ""}`}>
              Contact
            </a>
          </nav>
        </div>
      </header>

      <main class="app-main">
        <div class="app-container">
          <slot />
        </div>
      </main>

      <footer class="app-footer">
        <div class="app-container app-footer-inner">
          <span>
            © {new Date().getFullYear()} Romain-Rolland F Tohouri. All rights reserved.
          </span>
          <div class="app-footer-links">
            <a href="mailto:romain@tohouri.com">romain(at)tohouri.com</a>
            <a href="https://www.linkedin.com/in/tohouri/" target="_blank" rel="noreferrer">LinkedIn</a>
            <a href="https://github.com/romyt" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
