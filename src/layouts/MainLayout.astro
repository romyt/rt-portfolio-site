---
import "../styles/global.css";
import { getLangFromUrl, useTranslations, languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = "Romain-Rolland F Tohouri",
  description = "Portfolio of Romain-Rolland F Tohouri – digital health leader and DevOps engineer.",
  currentPath = "/",
} = Astro.props;

// Build localized paths
const basePath = currentPath.replace(/^\/(en|fr)/, '') || '/';
const enPath = basePath === '/' ? '/' : basePath;
const frPath = `/fr${basePath}`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="app-shell">
      <header class="app-header">
        <div class="app-container app-header-inner">
          <a href={lang === 'fr' ? '/fr' : '/'} class="brand" aria-label="Go to home">
            <div class="brand-avatar">RT</div>
            <div class="brand-meta">
              <span class="brand-name">Romain-Rolland F Tohouri</span>
              <span class="brand-tagline">Digital Health & DevOps</span>
            </div>
          </a>
          <nav class="nav-links" aria-label="Main navigation">
            <a href={lang === 'fr' ? '/fr' : '/'} class={`nav-link ${basePath === "/" ? "nav-link-active" : ""}`}>
              {t('nav.overview')}
            </a>
            <a href={lang === 'fr' ? '/fr/experience' : '/experience'} class={`nav-link ${basePath === "/experience" ? "nav-link-active" : ""}`}>
              {t('nav.experience')}
            </a>
            <a href={lang === 'fr' ? '/fr/projects' : '/projects'} class={`nav-link ${basePath === "/projects" ? "nav-link-active" : ""}`}>
              {t('nav.projects')}
            </a>
            <a href={lang === 'fr' ? '/fr/skills' : '/skills'} class={`nav-link ${basePath === "/skills" ? "nav-link-active" : ""}`}>
              {t('nav.skills')}
            </a>
            <a href={lang === 'fr' ? '/fr/contact' : '/contact'} class={`nav-link nav-link-pill ${basePath === "/contact" ? "nav-link-active" : ""}`}>
              {t('nav.contact')}
            </a>
            <!-- Language switcher -->
            <div class="lang-switcher">
              <a href={enPath} class={`lang-link ${lang === 'en' ? 'lang-link-active' : ''}`} aria-label="English">
                EN
              </a>
              <span class="lang-divider">/</span>
              <a href={frPath} class={`lang-link ${lang === 'fr' ? 'lang-link-active' : ''}`} aria-label="Français">
                FR
              </a>
            </div>
          </nav>
        </div>
      </header>

      <main class="app-main">
        <div class="app-container">
          <slot />
        </div>
      </main>

      <footer class="app-footer">
        <div class="app-container app-footer-inner">
          <span>
            © {new Date().getFullYear()} Romain-Rolland F Tohouri. {t('footer.rights')}
          </span>
          <div class="app-footer-links">
            <a href="https://www.linkedin.com/in/tohouri/" target="_blank" rel="noreferrer">LinkedIn</a>
            <a href="https://github.com/romyt" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
